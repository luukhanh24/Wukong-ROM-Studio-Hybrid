                                    Visibility="Collapsed"
                                    MinHeight="220"
                                    MaxHeight="520"
                                    SelectionMode="None"
                                    ScrollViewer.HorizontalScrollMode="Disabled"
                                    AutomationProperties.Name="Danh sách xem trước đổi tên ROM">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="8,9" ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="TÊN HIỆN TẠI" Foreground="{ThemeResource MutedBrush}" FontSize="10" CharacterSpacing="50" />
                                                    <TextBlock Text="{Binding SourceName}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="→" Foreground="{ThemeResource PrimaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="TÊN MỚI" Foreground="{ThemeResource MutedBrush}" FontSize="10" CharacterSpacing="50" />
                                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{ThemeResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding TargetName}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock Text="Không ghi đè file đã tồn tại. Mọi file phải hợp lệ trước khi batch được đổi tên." Style="{StaticResource MutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                    <Button x:Name="ApplyRomRenameButton" Grid.Column="1" Content="Xác nhận đổi tên" Style="{StaticResource AccentButtonStyle}" Click="ApplyRomRenameClick" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CatalogPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="SecondaryPageSizeChanged">
                    <StackPanel x:Name="CatalogContent" MaxWidth="1560" Padding="24,20,24,40" Spacing="16" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Danh mục thiết bị" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Quản lý cấu hình dung lượng super, group và logical partition dùng trong preflight/build." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Thêm thiết bị" Click="AddDeviceClick" VerticalAlignment="Center" />
                            <Button x:Name="DuplicateDeviceButton" Grid.Column="2" Content="Sao chép" Click="DuplicateDeviceClick" VerticalAlignment="Center" IsEnabled="False" />
                            <Button Grid.Column="3" Content="Làm mới" Click="RefreshDevicesClick" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBox
                                x:Name="DeviceSearchBox"
                                PlaceholderText="Tìm theo tên, product_name hoặc SoC"
                                TextChanged="DeviceSearchChanged"
                                AutomationProperties.Name="Tìm thiết bị" />
                            <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock x:Name="DeviceCountText" Text="0 thiết bị" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </Grid>
                        <Grid x:Name="DeviceCatalogGrid" ColumnSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="DeviceCatalogListColumn" Width="360" />
                                <ColumnDefinition x:Name="DeviceCatalogEditorColumn" Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="DeviceListCard" Style="{StaticResource CardStyle}" Padding="0">
                                <Grid RowDefinitions="Auto,*">
                                    <Grid Padding="16,14,16,10" ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Thiết bị đã cấu hình" FontWeight="SemiBold" />
                                            <TextBlock Text="Chọn một thiết bị để xem hoặc chỉnh sửa." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock x:Name="DeviceFilteredCountText" Grid.Column="1" Text="0 mục" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListView
                                        x:Name="DevicesList"
                                        Grid.Row="1"
                                        MinHeight="430"
                                        MaxHeight="620"
                                        SelectionMode="Single"
                                        SelectionChanged="DeviceSelectionChanged"
                                        ScrollViewer.HorizontalScrollMode="Disabled"
                                        AutomationProperties.Name="Danh sách thiết bị">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="8,7" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProductName}" Foreground="{ThemeResource PrimaryBrush}" FontFamily="Consolas" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Soc}" Foreground="{ThemeResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>

                            <Border x:Name="DeviceEditorCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Thông số thiết bị" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Các giá trị này quyết định layout super và được kiểm tra trước khi build." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                            <TextBlock x:Name="DeviceEditorModeText" Text="Chưa chọn" Foreground="{ThemeResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <InfoBar
                                        x:Name="DeviceEditorInfoBar"
                                        IsOpen="False"
                                        IsClosable="True"
                                        Severity="Informational" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <TextBox x:Name="DeviceProductNameBox" Header="Product name" PlaceholderText="PKG110" TextChanged="DeviceEditorChanged" />
                                        <TextBox x:Name="DeviceDisplayNameBox" Grid.Column="1" Header="Tên hiển thị" PlaceholderText="OnePlus Ace 5" TextChanged="DeviceEditorChanged" />
                                    </Grid>
                                    <Grid ColumnDefinitions="0.7*,1.15*,1.15*" ColumnSpacing="12">
                                        <TextBox x:Name="DeviceSocBox" Header="SoC" PlaceholderText="87xx" TextChanged="DeviceEditorChanged" />
                                        <TextBox x:Name="DeviceSuperSizeBox" Grid.Column="1" Header="SuperSize (byte)" PlaceholderText="15354134528" InputScope="Number" TextChanged="DeviceEditorChanged" />
                                        <TextBox x:Name="DeviceGroupSizeBox" Grid.Column="2" Header="GroupSize (byte)" PlaceholderText="15349940224" InputScope="Number" TextChanged="DeviceEditorChanged" />
                                    </Grid>
                                    <Border Style="{StaticResource SubtlePanelStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Kiểm tra dung lượng" FontWeight="SemiBold" FontSize="12" />
                                                <TextBlock x:Name="DeviceSizeSummaryText" Text="Nhập SuperSize và GroupSize để kiểm tra." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Căn chỉnh 4 KiB" Foreground="{ThemeResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBox
                                        x:Name="DevicePartitionsBox"
                                        Header="Logical partition bổ sung"
                                        PlaceholderText="Mỗi dòng một tên, ví dụ: my_company"
                                        AcceptsReturn="True"
                                        TextWrapping="NoWrap"
                                        Height="150"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        TextChanged="DeviceEditorChanged"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="File lưu cấu hình" FontWeight="SemiBold" FontSize="11" />
                                            <TextBlock x:Name="DeviceCatalogPathText" Text="devices_sizes.json" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Content="Hủy thay đổi" Click="CancelDeviceEditClick" />
                                            <Button x:Name="DeleteDeviceButton" Content="Xóa" Click="DeleteDeviceClick" IsEnabled="False" />
                                            <Button x:Name="SaveDeviceButton" Content="Lưu thiết bị" Click="SaveDeviceClick" Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Partition Layout Analyzer" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Đối chiếu SuperSize, GroupSize và logical partition của thiết bị đang chọn với super.img hoặc kết quả lpdump." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="LayoutAnalyzerStatusText" Text="Chưa phân tích" Foreground="{ThemeResource MutedBrush}" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="LayoutSourceBox" IsReadOnly="True" PlaceholderText="Chưa chọn super.img, metadata JSON hoặc lpdump TXT" />
                                    <Button Grid.Column="1" Content="Chỉ kiểm tra catalog" Click="AnalyzeCatalogLayoutClick" />
                                    <Button Grid.Column="2" Content="Chọn nguồn và phân tích" Style="{StaticResource AccentButtonStyle}" Click="BrowseLayoutSourceClick" />
                                </Grid>
                                <InfoBar x:Name="LayoutAnalyzerInfoBar" IsOpen="False" IsClosable="True" />
                                <Grid ColumnDefinitions="0.7*,1.3*" ColumnSpacing="10">
                                    <Border Style="{StaticResource SubtlePanelStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ĐIỂM AN TOÀN" FontSize="10" Foreground="{ThemeResource MutedBrush}" CharacterSpacing="60" />
                                            <TextBlock x:Name="LayoutScoreText" Text="--" FontSize="32" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display" />
                                            <TextBlock x:Name="LayoutSizeSummaryText" Text="Chọn thiết bị để bắt đầu." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource SubtlePanelStyle}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Group usage và khuyến nghị" FontWeight="SemiBold" FontSize="12" />
                                            <StackPanel x:Name="LayoutGroupsPanel" Spacing="5" />
                                            <TextBlock x:Name="LayoutRecommendationText" Text="Chưa có dữ liệu." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                            <TextBlock Text="MOD" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ModCountText" Grid.Column="1" Text="0 MOD" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel x:Name="ModsCatalogPanel" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="SecondaryPageSizeChanged">
                    <StackPanel x:Name="DiagnosticsContent" MaxWidth="1560" Padding="24,20,24,40" Spacing="16" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Chẩn đoán" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Kiểm tra runtime, binary, dependency và dung lượng." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Chạy lại" Click="RefreshDiagnosticsClick" />
                        </Grid>
                        <StackPanel x:Name="DiagnosticsPanel" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="SecondaryPageSizeChanged">
                    <StackPanel x:Name="SettingsContent" MaxWidth="1180" Padding="24,20,24,40" Spacing="16" HorizontalAlignment="Center">
                        <TextBlock Text="Cài đặt" Style="{StaticResource PageTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBox x:Name="RootsBox" Header="Root được phép (mỗi dòng một đường dẫn tuyệt đối)" AcceptsReturn="True" Height="120" />
                                <Button Content="Thêm root bằng FolderPicker" HorizontalAlignment="Left" Click="AddRootFolderClick" />
                                <ComboBox x:Name="DefaultPresetCombo" Header="Preset mặc định">
                                    <ComboBoxItem Content="Lite" Tag="lite" />
                                    <ComboBoxItem Content="Plus" Tag="resume" />
                                    <ComboBoxItem Content="Lite + Plus" Tag="both" />
                                    <ComboBoxItem Content="Custom" Tag="custom" />
                                </ComboBox>
                                <ComboBox x:Name="ZipValidationModeCombo" Header="Hậu kiểm ZIP">
                                    <ComboBoxItem Content="Nhanh (khuyến nghị)" Tag="fast" />
                                    <ComboBoxItem Content="CRC toàn phần" Tag="deep" />
                                </ComboBox>
                                <TextBlock Text="Chế độ nhanh vẫn kiểm tra image bắt buộc, manifest và cấu trúc super.img; CRC toàn phần đọc lại toàn bộ ZIP." Style="{StaticResource MutedTextStyle}" FontSize="11" TextWrapping="Wrap" />
                                <CheckBox x:Name="DefaultTelegramCheckBox" Content="Bật thông báo Telegram mặc định" />
                                <Button Content="Lưu cài đặt" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveSettingsClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Giao diện và Build Console" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Các tùy chọn này chỉ ảnh hưởng ứng dụng Windows và được lưu trong desktop-settings.json." Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <ComboBox x:Name="LanguageCombo" Header="Ngôn ngữ" SelectionChanged="LanguageChanged">
                                            <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                                            <ComboBoxItem Content="English" Tag="en" />
                                        </ComboBox>
                                        <ComboBox x:Name="ThemeCombo" Grid.Column="1" Header="Chế độ giao diện" SelectionChanged="ThemeChanged">
                                            <ComboBoxItem Content="Theo hệ thống" Tag="system" />
                                            <ComboBoxItem Content="Sáng" Tag="light" />
                                            <ComboBoxItem Content="Tối" Tag="dark" />
                                        </ComboBox>
                                    </Grid>
                                    <ComboBox x:Name="LogRefreshCombo" Header="Tốc độ cập nhật log">
                                        <ComboBoxItem Content="Nhanh · 750 ms" Tag="750" />
                                        <ComboBoxItem Content="Cân bằng · 1000 ms" Tag="1000" />
                                        <ComboBoxItem Content="Tiết kiệm · 1500 ms" Tag="1500" />
                                        <ComboBoxItem Content="Chậm · 2000 ms" Tag="2000" />
                                    </ComboBox>
                                    <NumberBox x:Name="ConsoleBufferBox" Header="Bộ đệm console (nghìn ký tự)" Minimum="50" Maximum="500" SmallChange="25" SpinButtonPlacementMode="Compact" />
                                    <CheckBox x:Name="DefaultAutoScrollCheckBox" Content="Tự cuộn log mặc định" />
                                    <CheckBox x:Name="NavigationExpandedCheckBox" Content="Mở rộng menu bên trái khi khởi động" />
                                    <CheckBox x:Name="ExpandModsCheckBox" Content="Mở sẵn danh sách MOD" />
                                    <CheckBox x:Name="ExpandPipelineCheckBox" Content="Mở sẵn pipeline" />
                                    <Button Content="Lưu tùy chọn Windows" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveDesktopSettingsClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Stage cache" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Tái sử dụng payload đã extract bằng SHA-256; cache không thay đổi nội dung ROM nguồn." Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="CacheUsageText" Grid.Column="1" Text="0 B / 0 B" Foreground="{ThemeResource PrimaryBrush}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="10">
                                    <ToggleSwitch x:Name="StageCacheToggle" Header="Bật cache extract payload" OnContent="Bật" OffContent="Tắt" />
                                    <NumberBox x:Name="StageCacheMaxBox" Grid.Column="1" Header="Dung lượng tối đa (GiB)" Minimum="5" Maximum="500" SmallChange="5" SpinButtonPlacementMode="Compact" />
                                    <Button Grid.Column="2" Content="Lưu cache" Click="SaveCacheSettingsClick" VerticalAlignment="Bottom" />
                                    <Button Grid.Column="3" Content="Xóa cache" Click="ClearCacheClick" VerticalAlignment="Bottom" />
                                </Grid>
                                <TextBlock x:Name="CacheDetailText" Text="Chưa tải trạng thái cache." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Phiên bản Wukong theo nền MOD" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Giá trị này được dùng đồng thời cho tên ZIP, info.txt và ro.build.version.oplusrom.display." Style="{StaticResource MutedTextStyle}" />
                                <StackPanel x:Name="StudioVersionsPanel" Spacing="7" />
                                <Button Content="Lưu số phiên bản" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="SaveStudioVersionsClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Telegram" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Token được mã hóa bằng Windows DPAPI và không được hiển thị lại." Style="{StaticResource MutedTextStyle}" />
                                <PasswordBox x:Name="TelegramTokenBox" Header="Bot token mới" PlaceholderText="Nhập token để thay đổi cấu hình" />
                                <TextBox x:Name="TelegramChatIdBox" Header="Chat ID" />
                                <Button Content="Lưu Telegram và khởi động lại backend" HorizontalAlignment="Right" Click="ConfigureTelegramClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="GitHub Actions và Google Drive" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Token GitHub và rclone.conf được mã hóa bằng Windows DPAPI và không hiển thị lại." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                                <TextBox x:Name="HybridRepositoryBox" Header="GitHub repository" Text="luukhanh24/Wukong-ROM-Studio-Hybrid" />
                                <PasswordBox x:Name="HybridGitHubTokenBox" Header="Fine-grained GitHub token" PlaceholderText="Actions write, Metadata read, Administration read" />
                                <TextBox x:Name="HybridRcloneConfigBox" Header="Nội dung rclone.conf" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="120" FontFamily="Consolas" />
                                <Button Content="Mã hóa cấu hình hybrid và khởi động lại backend" HorizontalAlignment="Right" Click="ConfigureHybridSecretsClick" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Thư mục ứng dụng" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="InstallRootText" FontFamily="Consolas" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                    <Button Content="Mở output" Click="OpenOutputClick" HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Content="Mở workspace" Click="OpenWorkspaceClick" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="1" Content="Mở log" Click="OpenLogsClick" HorizontalAlignment="Stretch" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="Khởi động lại backend" Click="RestartBackendClick" HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>

        <ContentDialog
            x:Name="DebloatDialog"
            Title="Bước 04 · Xóa ứng dụng không cần thiết"
            PrimaryButtonText="Áp dụng và lưu"
            SecondaryButtonText="Khôi phục mặc định"
            CloseButtonText="Hủy"
            DefaultButton="Primary">
            <StackPanel Width="640" Spacing="12">
                <InfoBar
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Danh sách dùng chung cho CLI và Windows app"
                    Message="Mỗi dòng là một đường dẫn tương đối bắt đầu bằng tên phân vùng. Backend sẽ chặn đường dẫn tuyệt đối, traversal và phân vùng không được phép chỉnh sửa." />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Đường dẫn cần xóa" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="10" Padding="9,4">
                        <TextBlock x:Name="DebloatEditorCountText" Text="0 đường dẫn" Foreground="{ThemeResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBox
                    x:Name="DebloatPathsBox"
                    Height="260"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    PlaceholderText="my_stock\app\Browser"
                    TextChanged="DebloatPathsChanged"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                <TextBlock Text="Mẹo: để danh sách trống nếu muốn giữ toàn bộ ứng dụng ở bước này." Style="{StaticResource MutedTextStyle}" FontSize="11" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
