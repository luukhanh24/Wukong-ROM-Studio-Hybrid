                            <TextBlock Text="Đổi tên ROM" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Đọc version_name trong metadata, xem trước và xác nhận trước khi đổi tên ZIP." Style="{StaticResource MutedTextStyle}" />
