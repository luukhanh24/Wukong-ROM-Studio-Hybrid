                                </Border>
                                <TextBox x:Name="HybridResultBox" Header="Kết quả / log / link artifact" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

