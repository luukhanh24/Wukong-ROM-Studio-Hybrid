                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Xem trước thay đổi" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="RomRenamerSummaryText" Text="Chưa chọn ROM để kiểm tra." Style="{StaticResource MutedTextStyle}" FontSize="12" />
