                                        <ComboBoxItem Content="Chỉ tải ROM gốc lên cloud" Tag="source_mirror" />
                                        <ComboBoxItem Content="Build ROM" Tag="build" />
                                        <ComboBoxItem Content="Upload artifact" Tag="artifact_publish" />
                                    </ComboBox>
                                    <ComboBox x:Name="HybridSourceKindCombo" Grid.Column="1" Header="Loại nguồn" SelectedIndex="0">
                                        <ComboBoxItem Content="File local" Tag="local" />
                                        <ComboBoxItem Content="HTTP / HTTPS" Tag="https" />
                                        <ComboBoxItem Content="Google Drive (rclone)" Tag="rclone" />
                                    </ComboBox>
                                    <TextBox x:Name="HybridDeviceBox" Grid.Column="2" Header="Mã thiết bị" PlaceholderText="CPH2725" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="HybridSourceBox" Header="Nguồn ROM thông minh" PlaceholderText="Dán URL trực tiếp, link OPlus downloadCheck, Daniel Springer hoặc Drive" TextChanged="HybridSourceTextChanged" />
