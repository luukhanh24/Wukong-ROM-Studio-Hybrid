                                </Grid>
                                <InfoBar x:Name="HybridSourceProbeInfo" IsOpen="False" IsClosable="False" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <TextBox x:Name="HybridSourceDetailsBox" Header="Thông tin tự nhận diện" IsReadOnly="True" PlaceholderText="Nhà cung cấp · thiết bị · phiên bản · loại OTA" />
                                    <TextBox x:Name="HybridSourceSizeBox" Grid.Column="1" Header="Dung lượng tự nhận diện (byte)" IsReadOnly="True" />
                                </Grid>
                                <TextBox x:Name="HybridChecksumBox" Header="SHA-256 (khuyến nghị)" PlaceholderText="64 ký tự hex" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Build và nơi thực thi" Style="{StaticResource SectionTitleStyle}" />
