                                    </ScrollViewer>
                                    <InfoBar x:Name="SelectedJobErrorBar" IsOpen="False" IsClosable="False" Severity="Error" />
                                    <Border Background="{ThemeResource SubtleBackgroundBrush}" BorderBrush="{ThemeResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Artifact / workspace" FontSize="11" Foreground="{ThemeResource MutedBrush}" />
                                                <TextBlock x:Name="SelectedJobArtifact" Text="Chưa có artifact." FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                <Button x:Name="CopyArtifactButton" Content="Sao chép" Click="CopyArtifactClick" IsEnabled="False" />
                                                <Button x:Name="OpenArtifactButton" Content="Mở" Click="OpenSelectedArtifactClick" IsEnabled="False" />
                                                <Button x:Name="OpenJobWorkspaceButton" Content="Workspace" Click="OpenSelectedWorkspaceClick" IsEnabled="False" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox x:Name="LogSearchBox" PlaceholderText="Tìm trong log đang hiển thị..." TextChanged="LogSearchChanged" />
