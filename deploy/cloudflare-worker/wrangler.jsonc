{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wukong-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "WUKONG_RELEASE_SHA": "development",
    "WUKONG_ALLOWED_ORIGINS": "https://wukong-rom-studio.vercel.app",
    "WUKONG_TELEGRAM_ADMIN_IDS": "1678823419",
    "WUKONG_TELEGRAM_BOT_USERNAME": "WK_build_bot",
    "WUKONG_TELEGRAM_WEB_APP_URL": "https://wukong-rom-studio.vercel.app/",
    "WUKONG_GITHUB_REPOSITORY": "xuankhanh24/Wukong-ROM-Studio-Hybrid",
    "WUKONG_GITHUB_WORKFLOW": "wukong-build.yml",
    "WUKONG_GITHUB_REF": "main",
    "WUKONG_GOOGLE_DRIVE_FOLDER_ID": "1uTt-4ECmUhpJeSc8FoBLknn8HJ9e6YNv",
    "WUKONG_PUBLIC_API_URL": "https://wukong-control-plane.wukong-rom-studio-api.workers.dev",
    "WUKONG_SOURCE_TRANSPORT_URL": "https://wukong-rom-studio.vercel.app/api/source-transport",
    "WUKONG_DCCLOUD_SHARE_URL": "https://cloud.dabeecao.org/s/oyZf7",
    "WUKONG_DCCLOUD_ROOT": "ROM"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wukong-control-plane-db",
      "database_id": "fa83d481-857e-4f6f-9dd6-38d46bdf8c86",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "env": {
    "staging": {
      "name": "wukong-control-plane-staging",
      "vars": {
        "WUKONG_RELEASE_SHA": "development",
        "WUKONG_ALLOWED_ORIGINS": "https://wukong-rom-studio.vercel.app",
        "WUKONG_TELEGRAM_ADMIN_IDS": "1678823419",
        "WUKONG_TELEGRAM_BOT_USERNAME": "WK_build_bot",
        "WUKONG_TELEGRAM_WEB_APP_URL": "https://wukong-rom-studio.vercel.app/",
        "WUKONG_GITHUB_REPOSITORY": "xuankhanh24/Wukong-ROM-Studio-Hybrid",
        "WUKONG_GITHUB_WORKFLOW": "wukong-build.yml",
        "WUKONG_GITHUB_REF": "main",
        "WUKONG_GOOGLE_DRIVE_FOLDER_ID": "1uTt-4ECmUhpJeSc8FoBLknn8HJ9e6YNv",
        "WUKONG_PUBLIC_API_URL": "https://wukong-control-plane-staging.wukong-rom-studio-api.workers.dev",
        "WUKONG_SOURCE_TRANSPORT_URL": "https://wukong-rom-studio.vercel.app/api/source-transport",
        "WUKONG_DCCLOUD_SHARE_URL": "https://cloud.dabeecao.org/s/oyZf7",
        "WUKONG_DCCLOUD_ROOT": "ROM"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wukong-control-plane-staging-db",
          "database_id": "5d3e91be-51fd-4fe5-a26e-758632e12c77",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "wukong-control-plane",
      "vars": {
        "WUKONG_RELEASE_SHA": "development",
        "WUKONG_ALLOWED_ORIGINS": "https://wukong-rom-studio.vercel.app",
        "WUKONG_TELEGRAM_ADMIN_IDS": "1678823419",
        "WUKONG_TELEGRAM_BOT_USERNAME": "WK_build_bot",
        "WUKONG_TELEGRAM_WEB_APP_URL": "https://wukong-rom-studio.vercel.app/",
        "WUKONG_GITHUB_REPOSITORY": "xuankhanh24/Wukong-ROM-Studio-Hybrid",
        "WUKONG_GITHUB_WORKFLOW": "wukong-build.yml",
        "WUKONG_GITHUB_REF": "main",
        "WUKONG_GOOGLE_DRIVE_FOLDER_ID": "1uTt-4ECmUhpJeSc8FoBLknn8HJ9e6YNv",
        "WUKONG_PUBLIC_API_URL": "https://wukong-control-plane.wukong-rom-studio-api.workers.dev",
        "WUKONG_SOURCE_TRANSPORT_URL": "https://wukong-rom-studio.vercel.app/api/source-transport",
        "WUKONG_DCCLOUD_SHARE_URL": "https://cloud.dabeecao.org/s/oyZf7",
        "WUKONG_DCCLOUD_ROOT": "ROM"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wukong-control-plane-db",
          "database_id": "fa83d481-857e-4f6f-9dd6-38d46bdf8c86",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
