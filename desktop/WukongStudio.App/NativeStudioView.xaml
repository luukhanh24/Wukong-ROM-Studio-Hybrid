                <ScrollViewer x:Name="HybridPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="SecondaryPageSizeChanged">
