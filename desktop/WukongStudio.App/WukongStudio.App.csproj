<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>WukongStudio.App</RootNamespace>
    <AssemblyName>WukongStudio</AssemblyName>
    <ApplicationIcon>Assets\WukongStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\WukongStudio.Core\WukongStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\WukongStudio.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\WukongStudio.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\WukongStudio.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWinUiResourcesToPublishDirectory" AfterTargets="Publish">
    <ItemGroup>
      <WinUiPublishResource Include="$(TargetDir)*.xbf" />
      <WinUiPublishResource Include="$(TargetDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUiPublishResource)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
