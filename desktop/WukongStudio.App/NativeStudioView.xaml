                                        <TextBlock x:Name="ContentSyncSelectionText" Text="Chọn thư mục trong Content; Content\STARK chứa WK_Manager và com." Style="{StaticResource MutedTextStyle}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                        <Grid x:Name="ContentSyncActionsGrid" ColumnSpacing="8">
