<UserControl
    x:Class="WukongStudio.App.NativeStudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="Segoe UI Variable Text">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Light">
                <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F3F5F8" />
                <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                <SolidColorBrush x:Key="CardBorderBrush" Color="#DDE3EA" />
                <SolidColorBrush x:Key="PrimaryBrush" Color="#0B6BCB" />
                <SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A" />
                <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#F8FAFC" />
                <SolidColorBrush x:Key="SubtleBorderBrush" Color="#E2E7ED" />
                <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#F0F3F7" />
                <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#101722" />
                <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#263447" />
                <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Dark">
                <SolidColorBrush x:Key="PageBackgroundBrush" Color="#11161D" />
                <SolidColorBrush x:Key="CardBackgroundBrush" Color="#19212B" />
                <SolidColorBrush x:Key="CardBorderBrush" Color="#303B49" />
                <SolidColorBrush x:Key="PrimaryBrush" Color="#67B8FF" />
                <SolidColorBrush x:Key="MutedBrush" Color="#A8B4C3" />
                <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#202A36" />
                <SolidColorBrush x:Key="SubtleBorderBrush" Color="#354253" />
                <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#273240" />
                <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#090E14" />
                <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#344255" />
                <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="KpiCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SubtlePanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource SubtleBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" Background="{ThemeResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ResponsiveLayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.Setters>
                        <Setter Target="SystemHealthColumn.Width" Value="*" />
                        <Setter Target="EnvironmentColumn.Width" Value="0" />
                        <Setter Target="EnvironmentCard.(Grid.Row)" Value="1" />
                        <Setter Target="EnvironmentCard.(Grid.Column)" Value="0" />
                        <Setter Target="SystemOverviewGrid.RowSpacing" Value="10" />
                        <Setter Target="JobsColumn.Width" Value="*" />
                        <Setter Target="ConsoleColumn.Width" Value="0" />
                        <Setter Target="ConsoleCard.(Grid.Row)" Value="1" />
                        <Setter Target="ConsoleCard.(Grid.Column)" Value="0" />
                        <Setter Target="JobsConsoleGrid.RowSpacing" Value="10" />
                        <Setter Target="KpiThirdColumn.Width" Value="0" />
                        <Setter Target="KpiFourthColumn.Width" Value="0" />
                        <Setter Target="KpiArtifactCard.(Grid.Row)" Value="1" />
                        <Setter Target="KpiArtifactCard.(Grid.Column)" Value="0" />
                        <Setter Target="KpiDeviceCard.(Grid.Row)" Value="1" />
                        <Setter Target="KpiDeviceCard.(Grid.Column)" Value="1" />
                        <Setter Target="BuildVersionColumn.Width" Value="0" />
                        <Setter Target="PresetCombo.(Grid.Row)" Value="1" />
                        <Setter Target="PresetCombo.(Grid.Column)" Value="0" />
                        <Setter Target="StudioVersionPanel.(Grid.Row)" Value="1" />
                        <Setter Target="StudioVersionPanel.(Grid.Column)" Value="1" />
                        <Setter Target="NotifyTelegramPanel.(Grid.Row)" Value="2" />
                        <Setter Target="NotifyTelegramPanel.(Grid.Column)" Value="0" />
                        <Setter Target="NotifyTelegramPanel.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="BuildIdentityGrid.RowSpacing" Value="10" />
                        <Setter Target="DeviceCatalogListColumn.Width" Value="*" />
                        <Setter Target="DeviceCatalogEditorColumn.Width" Value="0" />
                        <Setter Target="DeviceEditorCard.(Grid.Row)" Value="1" />
                        <Setter Target="DeviceEditorCard.(Grid.Column)" Value="0" />
                        <Setter Target="DeviceCatalogGrid.RowSpacing" Value="12" />
                        <Setter Target="ContentSyncSecondActionColumn.Width" Value="0" />
                        <Setter Target="PublishContentManifestButton.(Grid.Row)" Value="1" />
                        <Setter Target="PublishContentManifestButton.(Grid.Column)" Value="0" />
                        <Setter Target="ContentSyncActionsGrid.RowSpacing" Value="8" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.Setters>
                        <Setter Target="SystemHealthColumn.Width" Value="1.1*" />
                        <Setter Target="EnvironmentColumn.Width" Value="0.9*" />
                        <Setter Target="EnvironmentCard.(Grid.Row)" Value="0" />
                        <Setter Target="EnvironmentCard.(Grid.Column)" Value="1" />
                        <Setter Target="SystemOverviewGrid.RowSpacing" Value="0" />
                        <Setter Target="DeviceCatalogListColumn.Width" Value="340" />
                        <Setter Target="DeviceCatalogEditorColumn.Width" Value="*" />
                        <Setter Target="DeviceEditorCard.(Grid.Row)" Value="0" />
                        <Setter Target="DeviceEditorCard.(Grid.Column)" Value="1" />
                        <Setter Target="DeviceCatalogGrid.RowSpacing" Value="0" />
                        <Setter Target="BuildVersionColumn.Width" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.Setters>
                        <Setter Target="SystemHealthColumn.Width" Value="1.1*" />
                        <Setter Target="EnvironmentColumn.Width" Value="0.9*" />
                        <Setter Target="EnvironmentCard.(Grid.Row)" Value="0" />
                        <Setter Target="EnvironmentCard.(Grid.Column)" Value="1" />
                        <Setter Target="SystemOverviewGrid.RowSpacing" Value="0" />
                        <Setter Target="JobsColumn.Width" Value="300" />
                        <Setter Target="ConsoleColumn.Width" Value="*" />
                        <Setter Target="ConsoleCard.(Grid.Row)" Value="0" />
                        <Setter Target="ConsoleCard.(Grid.Column)" Value="1" />
                        <Setter Target="JobsConsoleGrid.RowSpacing" Value="0" />
                        <Setter Target="KpiThirdColumn.Width" Value="*" />
                        <Setter Target="KpiFourthColumn.Width" Value="*" />
                        <Setter Target="KpiArtifactCard.(Grid.Row)" Value="0" />
                        <Setter Target="KpiArtifactCard.(Grid.Column)" Value="2" />
                        <Setter Target="KpiDeviceCard.(Grid.Row)" Value="0" />
                        <Setter Target="KpiDeviceCard.(Grid.Column)" Value="3" />
                        <Setter Target="BuildVersionColumn.Width" Value="*" />
                        <Setter Target="NotifyTelegramPanel.(Grid.Row)" Value="1" />
                        <Setter Target="NotifyTelegramPanel.(Grid.Column)" Value="0" />
                        <Setter Target="NotifyTelegramPanel.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="BuildIdentityGrid.RowSpacing" Value="0" />
                        <Setter Target="DeviceCatalogListColumn.Width" Value="360" />
                        <Setter Target="DeviceCatalogEditorColumn.Width" Value="*" />
                        <Setter Target="DeviceEditorCard.(Grid.Row)" Value="0" />
                        <Setter Target="DeviceEditorCard.(Grid.Column)" Value="1" />
                        <Setter Target="DeviceCatalogGrid.RowSpacing" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <InfoBar x:Name="NativeMessageBar" Margin="16,8" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
        <NavigationView Grid.Row="1"
            x:Name="StudioNavigation"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            OpenPaneLength="224"
            CompactPaneLength="52"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1100"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="StudioNavItem" Content="Bảng điều khiển" Tag="studio">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ArtifactsNavItem" Content="Bản build" Tag="artifacts">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="HybridNavItem" Content="Hybrid Cloud" Tag="hybrid">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Sync" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="RomRenamerNavItem" Content="Đổi tên ROM" Tag="rom-renamer">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CatalogNavItem" Content="Danh mục" Tag="catalog">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DiagnosticsNavItem" Content="Chẩn đoán" Tag="diagnostics">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNavItem" Content="Cài đặt" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <ScrollViewer x:Name="StudioPage" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="StudioPageSizeChanged" ViewChanged="StudioPageViewChanged">
                    <StackPanel x:Name="StudioContent" MaxWidth="1560" Padding="24,20,24,40" Spacing="16" HorizontalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Trung tâm điều khiển" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="Theo dõi hệ thống, cấu hình pipeline, quản lý queue và console trong một màn hình." Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" VerticalAlignment="Center">
                                <AppBarButton Label="Làm mới tất cả" Click="RefreshDashboardClick" />
                                <AppBarButton Label="Mở ROM hoàn tất" Click="OpenOutputClick" />
                            </CommandBar>
                        </Grid>

                        <Grid x:Name="KpiGrid" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="KpiThirdColumn" Width="0" />
                                <ColumnDefinition x:Name="KpiFourthColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource KpiCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="JOB ĐANG CHẠY" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" CharacterSpacing="55" />
                                    <TextBlock x:Name="ActiveJobsText" Text="0" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="Running hoặc packaging" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="ROM ĐANG CHỜ" Foreground="#B05A00" FontWeight="SemiBold" FontSize="11" CharacterSpacing="55" />
                                    <TextBlock x:Name="QueuedJobsText" Text="0" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="Xử lý tuần tự trong queue" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="KpiArtifactCard" Grid.Row="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="ARTIFACT HỢP LỆ" Foreground="#107C10" FontWeight="SemiBold" FontSize="11" CharacterSpacing="55" />
                                    <TextBlock x:Name="ValidArtifactsText" Text="0" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="ROM ZIP còn tồn tại" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="KpiDeviceCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource KpiCardStyle}">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="THIẾT BỊ HỖ TRỢ" Foreground="#7A3E9D" FontWeight="SemiBold" FontSize="11" CharacterSpacing="55" />
                                    <TextBlock x:Name="SupportedDevicesText" Text="0" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="Theo devices_sizes.json" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="SystemOverviewGrid" RowDefinitions="Auto,Auto" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="SystemHealthColumn" Width="*" />
                                <ColumnDefinition x:Name="EnvironmentColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Tình trạng hệ thống" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock x:Name="BackendVersionText" Text="-" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                        </StackPanel>
                                    <Border x:Name="BackendStateBadge" Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock x:Name="BackendStateText" Text="Đang kết nối" Foreground="#107C10" FontWeight="SemiBold" FontSize="12" />
                                        </Border>
                                    </Grid>
                                    <StackPanel x:Name="OverviewHealthPanel" Spacing="7" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="EnvironmentCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="11">
                                    <TextBlock Text="Môi trường và thao tác nhanh" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                        <TextBlock Text="Dung lượng" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="DiskFreeText" Grid.Column="1" Text="-" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Workspace" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="WorkspacePathText" Grid.Row="1" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="Output" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="OutputPathText" Grid.Row="2" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="3" Text="Nội dung" Foreground="{ThemeResource MutedBrush}" />
                                        <TextBlock x:Name="ContentSummaryText" Grid.Row="3" Grid.Column="1" Text="-" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                        <Button Content="Mở workspace" Click="OpenWorkspaceClick" HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1" Content="Mở output" Click="OpenOutputClick" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="1" Content="Mở log" Click="OpenLogsClick" HorizontalAlignment="Stretch" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="Restart backend" Click="RestartBackendClick" HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel x:Name="RomCardContent" Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="ROM đầu vào" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Có thể chọn từng file ZIP hoặc nhập toàn bộ folder theo thứ tự tên." Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BrowseRomButton" Content="Duyệt ROM ZIP" Style="{StaticResource AccentButtonStyle}" Click="BrowseRomClick" />
                                        <Button x:Name="BrowseFolderButton" Content="Nhập folder" Click="BrowseFolderClick" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox x:Name="RomPathBox" PlaceholderText="D:\ROM\rom.zip" />
                                    <Button x:Name="AddRomPathButton" Grid.Column="1" Content="Thêm đường dẫn" Click="AddRomPathClick" />
                                </Grid>
                                <StackPanel x:Name="RomQueuePanel" Spacing="8">
                                    <TextBlock Text="Chưa có ROM trong hàng đợi." Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" Margin="0,12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel x:Name="BuildCardContent" Spacing="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Cấu hình bản build" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Chọn nền MOD, biến thể ROM và các tác vụ cần chạy. Mọi thay đổi thủ công sẽ chuyển sang Custom." Style="{StaticResource MutedTextStyle}" FontSize="12" />
                                    </StackPanel>
                                    <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" Padding="0">
                                        <AppBarButton Label="Nhập profile" Icon="OpenFile" Click="ImportBuildProfileClick" />
                                        <AppBarButton Label="Xuất profile" Icon="Save" Click="ExportBuildProfileClick" />
                                    </CommandBar>
                                </Grid>

                                <Grid x:Name="BuildIdentityGrid" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="BuildVersionColumn" Width="0" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModVersionCombo" Header="Nền MOD" SelectionChanged="ModVersionChanged" HorizontalAlignment="Stretch" />
                                    <ComboBox x:Name="PresetCombo" Grid.Column="1" Header="Biến thể build" SelectionChanged="PresetChanged" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="Lite" Tag="lite" />
                                        <ComboBoxItem Content="Plus" Tag="resume" />
                                        <ComboBoxItem Content="Lite + Plus" Tag="both" />
                                        <ComboBoxItem Content="Custom" Tag="custom" />
                                    </ComboBox>
                                    <Grid x:Name="StudioVersionPanel" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TextBox x:Name="StudioVersionBox" Header="Phiên bản Studio" PlaceholderText="V3.4" LostFocus="StudioVersionLostFocus" />
                                        <Button Grid.Column="1" Content="Lưu" Click="SaveStudioVersionClick" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <Border x:Name="NotifyTelegramPanel" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SubtlePanelStyle}" Padding="12,9" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="NotifyTelegramCheckBox" Content="Thông báo Telegram khi hoàn thành từng bản" IsChecked="True" VerticalAlignment="Center" Checked="NotifyTelegramChanged" Unchecked="NotifyTelegramChanged" />
                                    </Border>
                                </Grid>

                                <Border Style="{StaticResource SubtlePanelStyle}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Build Recipe" FontWeight="SemiBold" FontSize="14" />
                                                <TextBlock Text="Lưu toàn bộ MOD, pipeline, debloat và Telegram để áp dụng lại nhanh." Style="{StaticResource MutedTextStyle}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock x:Name="RecipeStateText" Grid.Column="1" Text="Chưa chọn recipe" Foreground="{ThemeResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="1.2*,1.2*,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="RecipeCombo" Header="Recipe đã lưu" SelectionChanged="RecipeSelectionChanged" />
                                            <TextBox x:Name="RecipeNameBox" Grid.Column="1" Header="Tên recipe" PlaceholderText="Daily Plus" />
                                            <CommandBar Grid.Column="2" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" Padding="0" VerticalAlignment="Bottom">
                                                <AppBarButton Label="Mới" Icon="Add" Click="NewRecipeClick" />
                                                <AppBarButton Label="Áp dụng" Click="ApplyRecipeClick" />
                                                <AppBarButton Label="Lưu" Icon="Save" Click="SaveRecipeClick" />
                                                <AppBarButton Label="So sánh" Click="CompareRecipeClick" />
                                                <AppBarButton x:Name="LockRecipeButton" Label="Khóa" Click="ToggleRecipeLockClick" />
                                                <AppBarButton Label="Xóa" Icon="Delete" Click="DeleteRecipeClick" />
                                            </CommandBar>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid x:Name="BuildSectionsGrid" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="BuildPipelineColumn" Width="0" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="ModOptionsCard" Style="{StaticResource SubtlePanelStyle}" MinWidth="0" VerticalAlignment="Top">
                                        <Expander x:Name="ModOptionsExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Tùy chọn MOD" FontWeight="SemiBold" FontSize="15" />
                                                        <TextBlock Text="Chỉ hiển thị MOD tương thích với nền đã chọn" Foreground="{ThemeResource MutedBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ModSelectionSummaryText" Text="0 đã chọn" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" FontSize="11" />
                                                    </Border>
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="10" Margin="0,12,0,0">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBox x:Name="ModSearchBox" PlaceholderText="Tìm MOD..." TextChanged="ModSearchChanged" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Chọn tất cả" Click="SelectAllModsClick" />
                                                        <Button Content="Bỏ chọn" Click="ClearModsClick" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid x:Name="ModsPanel" ColumnSpacing="8" RowSpacing="8" SizeChanged="ModsPanelSizeChanged" />
                                            </StackPanel>
                                        </Expander>
                                    </Border>

                                    <Border x:Name="BuildPipelineCard" Grid.Row="1" Style="{StaticResource SubtlePanelStyle}" MinWidth="0" VerticalAlignment="Top">
                                        <Expander x:Name="PipelineStepsExpander" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MinWidth="0">
                                            <Expander.Header>
                                                <Grid ColumnDefinitions="*,Auto" MinWidth="0">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="Pipeline build" FontWeight="SemiBold" FontSize="15" />
                                                        <TextBlock Text="Chọn bước cần chạy và chỉnh cấu hình riêng" Foreground="{ThemeResource MutedBrush}" FontSize="11" />
                                                    </StackPanel>
