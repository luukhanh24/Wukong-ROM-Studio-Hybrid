                                            <ComboBoxItem Content="Dòng quan trọng" Tag="important" />
                                            <ComboBoxItem Content="Cảnh báo + lỗi" Tag="warnings" />
                                            <ComboBoxItem Content="Chỉ lỗi" Tag="errors" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{ThemeResource BadgeBackgroundBrush}" CornerRadius="10" Padding="9,4">
                                                <TextBlock x:Name="LogSummaryText" Text="0 dòng" Foreground="{ThemeResource PrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="Sự kiện JSON và tiến độ ZIP lặp được ẩn mặc định" Style="{StaticResource MutedTextStyle}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CommandBar Grid.Column="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent" Padding="0">
                                            <AppBarToggleButton x:Name="FollowLogButton" Label="Tự cuộn" IsChecked="True" />
                                            <AppBarToggleButton x:Name="PauseLogButton" Label="Tạm dừng" Checked="PauseLogChanged" Unchecked="PauseLogChanged" />
                                            <AppBarToggleButton x:Name="WrapLogButton" Label="Xuống dòng" Checked="WrapLogChanged" Unchecked="WrapLogChanged" />
                                            <AppBarToggleButton x:Name="TechnicalLogButton" Label="Log kỹ thuật" Checked="TechnicalLogChanged" Unchecked="TechnicalLogChanged" />
                                            <AppBarButton Label="Sao chép" Icon="Copy" Click="CopyLogClick" />
                                            <AppBarButton Label="Tải log gốc" Icon="Download" Click="DownloadLogClick" />
                                            <AppBarButton Label="Gói chẩn đoán" Click="DownloadDiagnosticsBundleClick" />
                                            <AppBarButton Label="Xóa hiển thị" Icon="Clear" Click="ClearLogClick" />
                                        </CommandBar>
                                    </Grid>
                                    <Border Background="{ThemeResource ConsoleBackgroundBrush}" BorderBrush="{ThemeResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                        <RichEditBox
                                            x:Name="JobLogBox"
                                            Height="400"
                                            IsReadOnly="True"
                                            AcceptsReturn="True"
                                            IsSpellCheckEnabled="False"
                                            IsTextPredictionEnabled="False"
                                            TextWrapping="NoWrap"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Background="Transparent"
                                            Foreground="#D8E2F0"
                                            BorderThickness="0"
                                            SelectionHighlightColor="#355D8C"
