                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource SubtlePanelStyle}" Padding="9,7">
                                            <StackPanel Spacing="1"><TextBlock Text="CPU time" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock x:Name="MetricCpuText" Text="-" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SubtlePanelStyle}" Padding="9,7">
                                            <StackPanel Spacing="1"><TextBlock Text="LOG" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock x:Name="MetricLogText" Text="-" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Style="{StaticResource SubtlePanelStyle}" Padding="9,7">
                                            <StackPanel Spacing="1"><TextBlock Text="DISK trống" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock x:Name="MetricDiskText" Text="-" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                        <Border Grid.Column="4" Style="{StaticResource SubtlePanelStyle}" Padding="9,7">
                                            <StackPanel Spacing="1"><TextBlock Text="CACHE" FontSize="10" Foreground="{ThemeResource MutedBrush}" /><TextBlock x:Name="MetricCacheText" Text="-" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                                        </Border>
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled">
