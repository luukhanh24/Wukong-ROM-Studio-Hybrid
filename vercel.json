{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python -m tools.build_vercel_mini_app",
  "outputDirectory": ".vercel-static",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
